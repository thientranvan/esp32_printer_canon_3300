{
 NAME "Android A4 media-col validation (no printing)"
 OPERATION Validate-Job
 GROUP operation-attributes-tag
 ATTR charset attributes-charset utf-8
 ATTR language attributes-natural-language en
 ATTR uri printer-uri $uri
 ATTR mimeMediaType document-format image/pwg-raster
 GROUP job-attributes-tag
 ATTR integer copies 1
 ATTR keyword sides one-sided
 ATTR collection media-col {
   MEMBER collection media-size {
     MEMBER integer x-dimension 21000
     MEMBER integer y-dimension 29700
   }
   MEMBER keyword media-type stationery
   MEMBER keyword media-source main
   MEMBER integer media-top-margin 508
   MEMBER integer media-bottom-margin 508
   MEMBER integer media-left-margin 508
   MEMBER integer media-right-margin 508
 }
 STATUS successful-ok
}
